# Host port. It is bound to 127.0.0.1 for the reverse proxy only.
APP_PORT=3000

# Main PostgreSQL connection. Add sslmode=require when the database requires TLS.
DATABASE_URL="postgresql://user:password@db.example.internal:5432/base?schema=pdf_loader"

# Optional: separate connection/schema for the external edition source.
EXTERNAL_EDITION_DATABASE_URL="postgresql://user:password@db.example.internal:5432/base"
EXTERNAL_EDITION_SCHEMA="idz_ukr"
EXTERNAL_EDITION_SOURCE_CODE="idz-ukr"
EXTERNAL_EDITION_SOURCE_NAME="IDZ-UKR"

# Authentication
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Used only by `pnpm prisma:seed`; seeding is not performed by Docker startup.
ADMIN_LOGIN="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Admin"
